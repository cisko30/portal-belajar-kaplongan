rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Katalog materi, tugas, LKPD, quiz, pengumuman (dibaca seluruh warga sekolah)
    match /portal_catalog/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().size() <= 10;
    }

    // Akun siswa (password disimpan sebagai hash PBKDF2-SHA256 + salt)
    match /portal_accounts/{nis} {
      allow read, write: if true;
    }

    // Pengumpulan tugas, LKPD, quiz, & progres game
    match /portal_submissions/{subId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['jenis', 'itemKey', 'userId', 'entryJson'])
                            && request.resource.data.jenis in ['tugas', 'lkpd', 'quiz']
                            && request.resource.data.entryJson.size() <= 900000;
      allow delete: if true;
    }

    // Absensi & konfigurasi fitur bersama (__CONFIG__|modules)
    match /portal_attendance/{attId} {
      allow read, write: if true;
    }

    // Video & deskripsi katalog jenjang di halaman utama
    match /portal_topics/{topicId} {
      allow read, write: if true;
    }

    // Berkas & lampiran terpecah (chunked <= 8MB gratis di Firestore Spark)
    match /portal_files/{fileId} {
      allow read, write: if true;
      match /chunks/{chunkIdx} {
        allow read, write: if request.resource.data.data_b64.size() <= 700000;
      }
    }

    // Arena Live Quiz multipemain real-time
    match /portal_live_rooms/{pin} {
      allow read, write: if true;
    }

    // Pengaturan keamanan (hanya menyimpan SHA-256 hash passphrase guru/admin)
    match /portal_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
